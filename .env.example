# API Configuration
API_BASE_URL=https://us-central1-walmart-mobile-a6865.cloudfunctions.net
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3

# Environment
NODE_ENV=development
APP_ENV=development

# App Configuration
APP_NAME=Walmart Mobile
APP_VERSION=1.0.0
APP_BUNDLE_ID=com.walmartmobile.app
APP_SCHEME=walmart-mobile

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=walmart-mobile-a6865.firebaseapp.com
FIREBASE_PROJECT_ID=walmart-mobile-a6865
FIREBASE_STORAGE_BUCKET=walmart-mobile-a6865.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=210498650658
FIREBASE_APP_ID=your_firebase_app_id_here

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Google Services
GOOGLE_MAPS_API_KEY_IOS=your_ios_maps_key_here
GOOGLE_MAPS_API_KEY_ANDROID=your_android_maps_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Apple Services
APPLE_CLIENT_ID=com.walmartmobile.app.signin
APPLE_REDIRECT_URI=https://your-domain.com/auth/apple/callback

# Facebook Configuration
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_CLIENT_TOKEN=your_facebook_client_token_here

# Analytics
AMPLITUDE_API_KEY=your_amplitude_api_key_here
GOOGLE_ANALYTICS_TRACKING_ID=GA-XXXXXXXXX-X

# Push Notifications
EXPO_PUSH_TOKEN=ExponentPushToken[your_token_here]
FCM_SERVER_KEY=your_fcm_server_key_here

# Deep Linking
DEEP_LINK_SCHEME=walmart-mobile
UNIVERSAL_LINK_DOMAIN=your-domain.com

# Feature Flags
ENABLE_BIOMETRIC_AUTH=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_LOCATION_SERVICES=true
ENABLE_BARCODE_SCANNER=true
ENABLE_CAMERA_FEATURES=true
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true
ENABLE_PERFORMANCE_MONITORING=true

# Security (Keep these on backend only!)
# JWT_SECRET=your_jwt_secret_here
# ENCRYPTION_KEY=your_encryption_key_here
# HMAC_SECRET=your_hmac_secret_here

# External APIs
WALMART_API_KEY=your_walmart_api_key_here
USPS_API_KEY=your_usps_api_key_here
UPS_API_KEY=your_ups_api_key_here
FEDEX_API_KEY=your_fedex_api_key_here

# CDN & Assets
CDN_BASE_URL=https://cdn.walmart.com
ASSETS_BASE_URL=https://assets.walmart.com
IMAGE_BASE_URL=https://images.walmart.com

# Monitoring & Logging
SENTRY_DSN=https://your_sentry_dsn_here
BUGSNAG_API_KEY=your_bugsnag_api_key_here

# Development Tools
DEBUG_MODE=true
LOG_LEVEL=debug

# Testing
TEST_USER_EMAIL=test@walmartmobile.com
TEST_USER_PASSWORD=testpassword123
MOCK_API_ENABLED=false

# Store Configuration
DEFAULT_STORE_ID=1234
STORE_LOCATOR_RADIUS=25
MAX_DELIVERY_DISTANCE=15

# Payment Configuration
PAYMENT_PROCESSING_FEE=0.029
CURRENCY=USD
LOCALE=en-US

# Cache Configuration
CACHE_TTL=3600
CACHE_ENABLED=true
OFFLINE_CACHE_SIZE=50

# Rate Limiting
API_RATE_LIMIT=1000
API_RATE_WINDOW=3600

# Expo Configuration
EXPO_PROJECT_ID=your-expo-project-id
EXPO_OWNER=your-expo-username