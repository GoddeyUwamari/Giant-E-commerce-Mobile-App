export type UIKey = keyof typeof ui;

// ================================
// USAGE EXAMPLES:
// ================================

/*
// Import in your components like this:

// Method 1: Named imports
import { banners, products, thumbnails } from '../../assets/images';

// Usage:
<Image source={banners.banner_01} style={styles.bannerImage} />
<Image source={products.prod_01} style={styles.productImage} />
<Image source={thumbnails.thumb_01} style={styles.thumbnailImage} />

// Method 2: Default import
import images from '../../assets/images';

// Usage:
<Image source={images.banners.banner_01} style={styles.bannerImage} />
<Image source={images.products.prod_01} style={styles.productImage} />

// Method 3: Destructuring from default
import images from '../../assets/images';
const { banners, products } = images;

// Usage:
<Image source={banners.banner_01} style={styles.bannerImage} />
*/